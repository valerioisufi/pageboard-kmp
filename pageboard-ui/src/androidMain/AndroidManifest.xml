<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The files shared with the other applications (rememberFileSharer) -->
        <provider
            android:name="io.github.valerioisufi.pageboard.ui.platform.PageboardFileProvider"
            android:authorities="${applicationId}.pageboard.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pageboard_shared_files" />
        </provider>
    </application>
</manifest>
