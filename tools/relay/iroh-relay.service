# The relay of Pageboard as a systemd service (installed by install.sh)
[Unit]
Description=iroh relay of Pageboard
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/iroh-relay.toml
EnvironmentFile=/etc/iroh-relay/token.env
WorkingDirectory=/var/lib/iroh-relay
User=iroh-relay
Group=iroh-relay
# Ports 80 and 443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=iroh-relay
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/iroh-relay

[Install]
WantedBy=multi-user.target
